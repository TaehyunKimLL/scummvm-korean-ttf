+
 	// Update verbs
 	updateDirtyScreen(kVerbVirtScreen);
 
@@ -1478,6 +1482,10 @@ void ScummEngine::clearCharsetMask() {
 }
 
 void ScummEngine::clearTextSurface() {
+	// Drop any half-collected run: its destination is about to be wiped.
