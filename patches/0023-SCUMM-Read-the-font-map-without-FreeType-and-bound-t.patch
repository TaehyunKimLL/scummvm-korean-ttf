+					const int bx = (x * m) + x1 + offX;
+					const int by = (y * m) + y1 + offY;
+
+					if (bx >= 0 && by >= 0 && bx + m <= dest.w && by + m <= dest.h) {
+						byte *p = dst + (dest.pitch * offY) + offX;
+						for (int sy = 0; sy < m; ++sy) {
