-					for (int sy = 0; sy < m; ++sy) {
-						for (int sx = 0; sx < m; ++sx)
-							p[sy * dest.pitch + sx] = cTable[i];
+
+				if (bits & revBitMask(x % 8)) {
+					// Where this glyph pixel's m x m block lands. The
