From 112a4b8497a57db1532a8aec607810283f5fb0b0 Mon Sep 17 00:00:00 2001
From: Taehyun Kim <dice.thkim@gmail.com>
Date: Thu, 3 Sep 2026 13:01:32 +0000
Subject: [PATCH 01/18] SCUMM: Add hi-res text mode for Korean fan translations

Mirrors the FM-Towns/PC98 Japanese approach: keep the game graphics at
their original 320x200 resolution and scale them up on output, while
rendering the text overlay into a 2x/3x framebuffer so that glyphs can
carry more detail.

- New korean_hires_scale option (1-3), validated in loadKorFont()
- compositeHiResText(): DOS/VGA background upscaler + text compositor,
  the counterpart to TownsScreen / mac_drawStripToScreen()
- drawBits1Kor()/drawBitsN(): replicate glyph pixels into m x m blocks
  and scale the shadow/stroke offsets accordingly
- Generalise the hardcoded 'multiplier == 2' checks to 'multiplier > 1'
---
 engines/scumm/charset.cpp | 85 ++++++++++++++++++++++++++++++---------
 engines/scumm/gfx.cpp     | 62 +++++++++++++++++++++++++++-
 engines/scumm/scumm.cpp   |  6 +++
 engines/scumm/scumm.h     |  5 +++
 4 files changed, 139 insertions(+), 19 deletions(-)

diff --git a/engines/scumm/charset.cpp b/engines/scumm/charset.cpp
index 190e1818..935e1a85 100644
--- a/engines/scumm/charset.cpp
+++ b/engines/scumm/charset.cpp
@@ -242,6 +242,26 @@ void ScummEngine::loadKorFont() {
 			error("Couldn't load any font: %s", fp.getName());
 		}
 	}
+
+	// Hi-res text mode for the Korean fan translations. This works like the
+	// FM-Towns/PC98 Japanese modes: the game graphics stay at their original
+	// low resolution and get scaled up on output, while the text overlay is
+	// kept at the higher resolution, so that the glyphs can be rendered with
+	// much more detail than the 320x200 framebuffer would ever allow.
+	if (_koreanHiResScale > 1) {
+		if (_game.platform == Common::kPlatformFMTowns || _game.platform == Common::kPlatformPCEngine ||
+			_game.platform == Common::kPlatformSegaCD || _game.platform == Common::kPlatformNES ||
+			_game.platform == Common::kPlatformMacintosh || _game.platform == Common::kPlatformC64 ||
+			_game.platform == Common::kPlatformApple2GS) {
+			// These platforms already own the text surface / do their own scaling.
+			debug(1, "Korean hi-res mode not available on this platform, disabling");
+			_koreanHiResScale = 1;
+		} else {
+			_textSurfaceMultiplier = _koreanHiResScale;
+			debug(1, "Korean hi-res text mode enabled (scale %d)", _koreanHiResScale);
+		}
+	}
+
 	return;
 }
 
