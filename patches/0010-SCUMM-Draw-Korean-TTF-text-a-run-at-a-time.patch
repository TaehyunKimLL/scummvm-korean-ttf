+	_korTtfRunActive = false;
+
 	towns_fillTopLayerRect(0, 0, _textSurface.w, _textSurface.h, 0);
 	fill((byte *)_textSurface.getPixels(), _textSurface.pitch,
 #ifndef DISABLE_TOWNS_DUAL_LAYER_MODE
